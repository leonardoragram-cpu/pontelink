<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Ponte Links</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Inter:wght@600&display=swap" rel="stylesheet">
</head>
<body style="margin:0;background:#000;display:flex;justify-content:center">
<div style="width:100%;max-width:400px;background:#0E0E0E;padding:18px 16px 30px;min-height:100vh;font-family:Inter,sans-serif;box-sizing:border-box">
<img src="arvore.jpg" style="width:100%;max-width:360px;margin:10px auto 0;display:block">
<h1 style="font-family:'Cormorant Garamond',serif;font-size:42px;line-height:0.9;color:#fff;text-align:center;margin:16px 0">Pontifique seu link para o mundo todo</h1>
<div style="background:#1C1C1C;border:1.5px solid #E9C46A;border-radius:14px;padding:14px;display:flex;gap:10px;margin-bottom:14px"><span style="color:#E9C46A">🔗</span><input id="inp" placeholder="Cole seu link aqui..." style="flex:1;background:transparent;border:none;color:#fff;outline:none;font-size:15px"></div>
<button onclick="gerar()" style="width:100%;background:#E9C46A;color:#000;font-weight:800;padding:16px;border:none;border-radius:14px;margin-bottom:14px">GERAR PONTE LINKS</button>
<div id="res" style="border:1.5px dashed #E9C46A;border-radius:14px;padding:12px;display:none;justify-content:space-between;align-items:center;background:#151515;margin-bottom:12px"><span id="link" style="color:#fff;font-size:14px"></span><button onclick="copiar()" style="background:#fff;border:none;border-radius:8px;padding:8px 16px;font-weight:700">Copiar</button></div>
<button style="width:100%;background:#fff;border:none;border-radius:12px;padding:14px;font-weight:600;margin-bottom:10px">➕ Contribuir via Pix</button>
</div>
<script>
function gerar(){let v=document.getElementById('inp').value.trim();if(!v){alert('Cole um link');return}let c=Math.random().toString(36).substring(2,7);document.getElementById('link').textContent='pontelinks.com.br/p/'+c;document.getElementById('res').style.display='flex';}
function copiar(){navigator.clipboard.writeText(document.getElementById('link').textContent);alert('Copiado!');}
</script>
</body>
</html>
